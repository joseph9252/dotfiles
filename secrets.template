# Secrets Template
# Copy this to ~/.secrets and fill in your actual values

# Jira credentials
export JIRA_TOKEN=your_jira_token_here
export JIRA_EMAIL=your_email@example.com
export JIRA_PROJECT_KEY=YOUR_KEY
export JIRA_ENDPOINT=https://your-domain.atlassian.net/rest

# Github credentials
export GITHUB_ACCESS_TOKEN=your_github_token_here

# OpenAI API Key
export AUTO_COMMIT_MESSAGE_OPENAI_API_KEY="your_openai_key_here"

# AWS Profile
export AWS_PROFILE=your_profile
